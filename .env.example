YARNOTRON_APP_NAME=Yarnotron
YARNOTRON_ENVIRONMENT=local
YARNOTRON_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model server: "ollama" (default) or "openai" (LiteLLM, vLLM, llama.cpp...). See docs/llm-backends.md.
# YARNOTRON_LLM_BACKEND=ollama
YARNOTRON_DEFAULT_MODEL=gemma4:12b-mlx
YARNOTRON_SAFETY_MODEL=gemma4:e2b-mlx
YARNOTRON_EMBEDDING_MODEL=nomic-embed-text:v1.5
YARNOTRON_EMBEDDING_DIMENSIONS=768
YARNOTRON_REQUEST_TIMEOUT_SECONDS=30
# Pins sampling so a run is reproducible. Leave unset in normal use, or the
# child gets the same wording every time. Set it when recording or diffing the
# golden corpus: temperature 0 alone is not enough to make generation repeat.
# YARNOTRON_MODEL_SEED=42
# How many cautioned turns a child gets in one session before it ends. Only the
# milder keyword tier counts; sexual content and self-harm stop the turn on the
# first mention and never spend a strike.
# YARNOTRON_SAFETY_STRIKE_LIMIT=5
# Stories are a SQLite file under the platform application-support directory
# by default. Uncomment to override with a different file.
# YARNOTRON_DATA_DIR=~/Library/Application Support/Yarnotron
# YARNOTRON_DATABASE_URL=/path/to/yarnotron.db

# --- Home Assistant / headless use -----------------------------------------
# Required before the API is reachable from anything but this machine. Every
# /v1 request must then send `Authorization: Bearer <token>`. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset only when the API is bound to 127.0.0.1.
# YARNOTRON_API_TOKEN=

# --- OpenAI-compatible model server (for example LiteLLM) --------------------
# With YARNOTRON_LLM_BACKEND=openai the *_MODEL settings above are alias/model names on
# that server, and the Ollama URL is not used. Example for a LiteLLM proxy:
# YARNOTRON_LLM_BACKEND=openai
# YARNOTRON_LLM_BASE_URL=http://127.0.0.1:4000/v1
# YARNOTRON_LLM_API_KEY=
# YARNOTRON_DEFAULT_MODEL=yarn-story
# YARNOTRON_SAFETY_MODEL=yarn-safety
# YARNOTRON_EMBEDDING_MODEL=yarn-embed
# YARNOTRON_LLM_JSON_MODE=false
# YARNOTRON_LLM_THINKING_HINT=true
# EmbeddingGemma wants different prefixes for search queries and stored passages:
# YARNOTRON_EMBEDDING_QUERY_PREFIX=task: search result | query:
# YARNOTRON_EMBEDDING_DOCUMENT_PREFIX=title: none | text:
