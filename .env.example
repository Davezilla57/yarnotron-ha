YARNOTRON_APP_NAME=Yarnotron
YARNOTRON_ENVIRONMENT=local
YARNOTRON_OLLAMA_BASE_URL=http://127.0.0.1:11434
YARNOTRON_DEFAULT_MODEL=gemma4:12b-mlx
YARNOTRON_SAFETY_MODEL=gemma4:e2b-mlx
YARNOTRON_EMBEDDING_MODEL=nomic-embed-text:v1.5
YARNOTRON_EMBEDDING_DIMENSIONS=768
YARNOTRON_REQUEST_TIMEOUT_SECONDS=30
# Pins sampling so a run is reproducible. Leave unset in normal use, or the
# child gets the same wording every time. Set it when recording or diffing the
# golden corpus: temperature 0 alone is not enough to make generation repeat.
# YARNOTRON_MODEL_SEED=42
# How many cautioned turns a child gets in one session before it ends. Only the
# milder keyword tier counts; sexual content and self-harm stop the turn on the
# first mention and never spend a strike.
# YARNOTRON_SAFETY_STRIKE_LIMIT=5
# Stories are a SQLite file under the platform application-support directory
# by default. Uncomment to override with a different file.
# YARNOTRON_DATA_DIR=~/Library/Application Support/Yarnotron
# YARNOTRON_DATABASE_URL=/path/to/yarnotron.db
